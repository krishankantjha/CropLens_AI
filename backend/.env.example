# --- CropLens AI Backend Environment Variables Template ---
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.

# --- Environment Mode ---
# Options: development, production
ENVIRONMENT=development

# --- Security & Authentication ---
# Generate a secure random string for production
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Live Data Providers (REQUIRED for Live Sync) ---

# 1. Official Government of India (Agmarknet) API Key
# Get it from: https://www.data.gov.in/
AGMARKNET_API_KEY=
# Live sync tuning for Data.gov.in (Agmarknet resource API)
# Per-mandi queries with small pages; User-Agent is set in code (required by Data.gov.in).
AGMARKNET_API_PAGE_SIZE=50
AGMARKNET_MAX_PAGES=1
AGMARKNET_CONNECT_TIMEOUT_SECONDS=10
AGMARKNET_READ_TIMEOUT_SECONDS=30
AGMARKNET_TIMEOUT_SECONDS=30
AGMARKNET_RETRY_ATTEMPTS=0
AGMARKNET_INTER_REQUEST_DELAY_SECONDS=0.5

# 2. Planet / Sentinel Hub API Key
# Get it from: https://insights.planet.com/account/#/settings
SENTINEL_HUB_API_KEY=
NASA_POWER_CONNECT_TIMEOUT_SECONDS=10
NASA_POWER_TIMEOUT_SECONDS=30
NASA_POWER_RETRY_ATTEMPTS=1

SENTINEL_HUB_CONNECT_TIMEOUT_SECONDS=10
SENTINEL_HUB_TIMEOUT_SECONDS=45
SENTINEL_HUB_RETRY_ATTEMPTS=1
SENTINEL_HUB_LOOKBACK_DAYS=30
SENTINEL_HUB_MAX_CLOUD_COVERAGE=40
SENTINEL_HUB_RELAXED_CLOUD_COVERAGE=60
SENTINEL_HUB_INTER_REQUEST_DELAY_SECONDS=0.5

# Live merge fallbacks: use historical NDVI/weather when upstream is missing (recommended for demos).
LIVE_MERGE_ALLOW_HISTORICAL_NDVI_FALLBACK=true
LIVE_MERGE_ALLOW_HISTORICAL_WEATHER_FALLBACK=true
LIVE_MERGE_NDVI_LOOKBACK_DAYS=30
LIVE_MERGE_WEATHER_LOOKBACK_DAYS=14

# Persist merged serving dataset back to parquet after live refresh + monthly snapshot.
MASTER_PARQUET_PATH=
PARQUET_SNAPSHOT_ENABLED=true
PARQUET_SNAPSHOT_ON_LIVE_REFRESH=true
PARQUET_SNAPSHOT_MAX_BACKUPS=5

# --- Model bundle provisioning ---
# Absolute host path used by Docker Compose for the complete versioned model bundle.
# The mounted directory must contain registry.json, the active version folder, and isolation_forest.pkl.
MODEL_BUNDLE_PATH=
# Optional absolute or repository-relative path to registry.json when running outside Compose.
MODEL_REGISTRY_PATH=

# --- Database & Infrastructure ---
# Local repository-root default. Docker overrides this explicitly in docker-compose.yml.
DATABASE_URL=sqlite:///./backend/app/croplens.db

# Redis connection (Used for OTP storage and Rate Limiting)
# Development may fall back to in-memory storage; production requires reachable Redis.
REDIS_URL=redis://localhost:6379/0

# --- Twilio Verify SMS OTP ---
# Keep these values in backend/.env only. Never expose them to the frontend or commit them.
SMS_PROVIDER=local
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# --- Production API Documentation ---
# Set to 'true' if you need Swagger docs in a production environment
ENABLE_PRODUCTION_DOCS=false

# --- CORS Settings ---
# Comma-separated list of allowed origins (e.g., http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
