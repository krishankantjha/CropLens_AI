# --- CropLens AI Backend Environment Variables Template ---
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.

# --- Environment Mode ---
# Options: development, production
ENVIRONMENT=development

# --- Security & Authentication ---
# Generate a secure random string for production
JWT_SECRET_KEY=croplens_ai_jwt_secret_key_super_secure_btech_thesis_2026
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Live Data Providers (REQUIRED for Live Sync) ---

# 1. Official Government of India (Agmarknet) API Key
# Get it from: https://www.data.gov.in/
AGMARKNET_API_KEY=

# 2. Planet / Sentinel Hub API Key
# Get it from: https://insights.planet.com/account/#/settings
SENTINEL_HUB_API_KEY=

# --- Database & Infrastructure ---
# Default uses local SQLite file
DATABASE_URL=sqlite:///app/croplens.db

# Redis connection (Used for OTP storage and Rate Limiting)
# Default assumes local Redis. The system falls back to in-memory if unavailable.
REDIS_URL=redis://localhost:6379/0

# --- Production API Documentation ---
# Set to 'true' if you need Swagger docs in a production environment
ENABLE_PRODUCTION_DOCS=false

# --- CORS Settings ---
# Comma-separated list of allowed origins (e.g., http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
