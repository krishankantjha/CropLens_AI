# --- CropLens AI Backend Environment Variables Template ---
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.

# --- Environment Mode ---
# Options: development, production
ENVIRONMENT=development

# --- Security & Authentication ---
# Generate a secure random string for production
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Live Data Providers (REQUIRED for Live Sync) ---

# 1. Official Government of India (Agmarknet) API Key
# Get it from: https://www.data.gov.in/
AGMARKNET_API_KEY=
# Request timeout in seconds for each provider page
AGMARKNET_TIMEOUT_SECONDS=40
# Number of retries after a transient request failure, from 0 to 3
AGMARKNET_RETRY_ATTEMPTS=2

# 2. Planet / Sentinel Hub API Key
# Get it from: https://insights.planet.com/account/#/settings
SENTINEL_HUB_API_KEY=

# --- Model bundle provisioning ---
# Absolute host path used by Docker Compose for the complete versioned model bundle.
# The mounted directory must contain registry.json, the active version folder, and isolation_forest.pkl.
MODEL_BUNDLE_PATH=
# Optional absolute or repository-relative path to registry.json when running outside Compose.
MODEL_REGISTRY_PATH=

# --- Database & Infrastructure ---
# Local repository-root default. Docker overrides this explicitly in docker-compose.yml.
DATABASE_URL=sqlite:///./backend/app/croplens.db

# Redis connection (Used for OTP storage and Rate Limiting)
# Development may fall back to in-memory storage; production requires reachable Redis.
REDIS_URL=redis://localhost:6379/0

# --- Twilio Verify SMS OTP ---
# Keep these values in backend/.env only. Never expose them to the frontend or commit them.
SMS_PROVIDER=local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Production API Documentation ---
# Set to 'true' if you need Swagger docs in a production environment
ENABLE_PRODUCTION_DOCS=false

# --- CORS Settings ---
# Comma-separated list of allowed origins (e.g., http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
